<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  yarn-site.xml —— 伪分布式（单机）Hadoop 3.3.6 · 迭代一 M0.5
  由 hadoop/scripts/install_env.sh 从 yarn-site.xml.tmpl 渲染生成（两者一致：
  模板里的 ${env.VAR} 无需替换，渲染即拷贝，保证入库内容与模板不漂移）。
  单 NodeManager；内存按本机 8GB 收敛，避免 VM 资源不足（plan.md §10 风险对策）。

  可移植性（清单⑫）：路径一律用 `${env.HADOOP_DATA_DIR}` 环境变量替换，不提交
  机器相关的绝对路径；该变量由 conf/hadoop-env.sh / env.sh 导出。
-->
<configuration>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
    <description>MapReduce Shuffle 必需</description>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
    <value>org.apache.hadoop.mapred.ShuffleHandler</value>
  </property>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>localhost</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address</name>
    <value>localhost:8088</value>
  </property>
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>${env.HADOOP_DATA_DIR}/nodemanager/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>${env.HADOOP_DATA_DIR}/nodemanager/log</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>4096</value>
    <description>NodeManager 可用内存 4GB（本机 8GB，留一半给系统与 driver）</description>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>4096</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>4</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
    <description>关闭虚拟内存检查：容器 vmem 超限误杀是单机伪分布式的常见干扰</description>
  </property>
  <property>
    <name>yarn.nodemanager.disk-health-checker.max-disk-utilization-per-disk-percentage</name>
    <value>95.0</value>
    <description>磁盘 94G 可用；默认 90% 阈值在单机环境下易误判</description>
  </property>
</configuration>
